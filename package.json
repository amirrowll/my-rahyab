{
  "name": "rahyab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "build": "cross-env NODE_ENV=production next build",
    "postbuild": "next-sitemap",
    "start": "serve out",
    "preview": "npm run build && npx serve@latest out -l 3000",
    "serve": "npx serve@latest out -l 3000",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "analyze": "ANALYZE=true next build",
    "type-check": "tsc --noEmit",
    "deploy": "npm run build && npx serve@latest out",
    "clean": "if exist .next rmdir /s /q .next && if exist out rmdir /s /q out",
    "sitemap": "next-sitemap"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "date-fns-jalali": "^4.1.0-0",
    "echart": "^0.1.3",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "jalali-moment": "^3.3.11",
    "js-cookie": "^3.0.5",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.21",
    "next": "15.1.4",
    "react": "^19.0.0",
    "react-cookie": "^7.2.2",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.5",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.4.0",
    "react-leaflet": "^5.0.0",
    "react-select": "^5.10.0",
    "sharp": "^0.34.5",
    "swiper": "^11.2.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.0.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "daisyui": "^4.12.23",
    "eslint": "^9",
    "eslint-config-next": "15.1.4",
    "next-sitemap": "^4.2.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
